# /etc/geogrind/geogrind.env (0640 root:geogrind). Placeholders only; real values live on the
# host and nowhere else. One NAME=value per line, no quotes needed, no `export`.

# Required
GROQ_API_KEY=replace-with-the-groq-key
GEOCODER_CONTACT=replace-with-the-operator-e-mail
CLIENT_IP_HEADER=x-real-ip
APP_ORIGIN=https://geogrind.cz
STATE_DIR=/var/lib/geogrind

# Optional (defaults in .env.example)
GROQ_MODEL=
GEOCODER_URL=
DAILY_CAP=
