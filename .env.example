# Copy to .env.local and fill in. Never commit real values.

# Groq API key (free tier, https://console.groq.com/keys). Server only.
GROQ_API_KEY=

# Optional: Groq model (default openai/gpt-oss-20b).
GROQ_MODEL=

# Optional: Nominatim-compatible geocoder (default https://nominatim.openstreetmap.org).
GEOCODER_URL=
# Contact (e-mail or URL) put into the geocoder User-Agent. Required in production.
GEOCODER_CONTACT=

# Name of the request header holding the real client IP, always overwritten by your reverse
# proxy (e.g. x-real-ip, cf-connecting-ip). Required in production.
CLIENT_IP_HEADER=

# Allowed values of the Origin header, comma separated (default http://localhost:3000).
# Required in production, e.g. https://geogrind.example
APP_ORIGIN=

# Optional: directory for the rate-limit / cooldown state (default .data).
STATE_DIR=

# Optional: daily cap of AI calls for all users (default 500, keep below the Groq limit).
DAILY_CAP=
